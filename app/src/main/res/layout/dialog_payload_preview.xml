<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp">

    <!-- 危险警告 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/payload_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorErrorContainer"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="⚠️ 检测到高风险操作（root UID 或危险命令），请确认你了解后果！"
            android:textColor="?attr/colorOnErrorContainer"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 风险明细 -->
    <TextView
        android:id="@+id/payload_risk_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:lineSpacingMultiplier="1.3" />

    <!-- 强制确认输入（危险时显示） -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/payload_confirm_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorErrorContainer"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorError"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="该操作为高风险，请输入「确认执行」后继续"
                android:textColor="?attr/colorOnErrorContainer"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/payload_confirm_input_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="输入：确认执行"
                app:boxStrokeColor="?attr/colorError"
                app:hintTextColor="?attr/colorOnErrorContainer">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/payload_confirm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Payload 内容 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1B1B1B"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/payload_preview_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textColor="#E0E0E0"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.2"
                android:textIsSelectable="true" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>